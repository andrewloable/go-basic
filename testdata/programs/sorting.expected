package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Bubble sort
	a := make([]float32, int(float64(10))+1)
	//  Initialize with random-ish values
	a[int(float64(1))] = float64(64)
	a[int(float64(2))] = float64(34)
	a[int(float64(3))] = float64(25)
	a[int(float64(4))] = float64(12)
	a[int(float64(5))] = float64(22)
	a[int(float64(6))] = float64(11)
	a[int(float64(7))] = float64(90)
	a[int(float64(8))] = float64(1)
	a[int(float64(9))] = float64(45)
	a[int(float64(10))] = float64(7)
	fmt.Println("Before sort:")
	var i float32
	end_0 := float64(10)
	step_0 := 1
	for i = float64(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		fmt.Print(a[int(i)])
	}
	fmt.Println()
	//  Bubble sort
	end_1 := float64(9)
	step_1 := 1
	for i = float64(1); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		var j float32
		end_2 := (float64(10) - i)
		step_2 := 1
		for j = float64(1); (step_2 > 0 && j <= end_2) || (step_2 < 0 && j >= end_2) || (step_2 == 0); j += step_2 {
			if (a[int(j)] > a[int((j + float64(1)))]) {
				a[int(j)], a[int((j + float64(1)))] = a[int((j + float64(1)))], a[int(j)]
			}
		}
	}
	fmt.Println("After sort:")
	end_3 := float64(10)
	step_3 := 1
	for i = float64(1); (step_3 > 0 && i <= end_3) || (step_3 < 0 && i >= end_3) || (step_3 == 0); i += step_3 {
		fmt.Print(a[int(i)])
	}
	fmt.Println()
	os.Exit(0)
}
