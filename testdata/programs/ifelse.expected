package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	rt.RunMain(basicMain)
}

func basicMain() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var x float32
	_ = x

	// Test IF/THEN/ELSE constructs
	x = float32(15)
	if (x > 20) {
		fmt.Println("x is greater than 20")
	} else if (x > 10) {
		fmt.Println("x is greater than 10")
	} else if (x > 5) {
		fmt.Println("x is greater than 5")
	} else {
		fmt.Println("x is 5 or less")
	}
	//  Single-line IF
	if (x == 15) {
		fmt.Println("x is exactly 15")
	}
	os.Exit(0)
}
