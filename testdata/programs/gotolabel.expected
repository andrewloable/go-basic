package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Test GOTO and labels
	fmt.Println("Start")
	goto label_skip
	fmt.Println("This should not print")
label_skip:
	fmt.Println("After skip")
	//  Test GOSUB/RETURN
	goto label_greet // GOSUB
	fmt.Println("Back from GOSUB")
	goto label_done
label_greet:
	fmt.Println("Hello from GOSUB!")
	return // RETURN
label_done:
	fmt.Println("Done")
	os.Exit(0)
}
