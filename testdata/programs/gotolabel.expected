package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	rt.RunMain(basicMain)
}

func basicMain() {
	var gosubReturnAddr int
	_ = gosubReturnAddr

	// Test GOTO and labels
	fmt.Println("Start")
	goto label_skip
	fmt.Println("This should not print")
label_skip:
	fmt.Println("After skip")
	//  Test GOSUB/RETURN
	gosubReturnAddr = 1
	goto label_greet // GOSUB
	label_gosubReturn_1:
	fmt.Println("Back from GOSUB")
	goto label_done
label_greet:
	fmt.Println("Hello from GOSUB!")
	switch gosubReturnAddr { // RETURN
	case 1: goto label_gosubReturn_1
	}
label_done:
	fmt.Println("Done")
	os.Exit(0)
}
