package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var i float32
	var x float32
	_ = i
	_ = x

	// Test all loop constructs
	//  FOR/NEXT
	fmt.Println("FOR loop:")
	end_0 := float32(5)
	step_0 := float32(1)
	for i = float32(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		fmt.Print(i)
	}
	fmt.Println()
	//  FOR with STEP
	fmt.Println("FOR with STEP:")
	end_1 := float32(1)
	step_1 := float32((-2))
	for i = float32(10); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		fmt.Print(i)
	}
	fmt.Println()
	//  WHILE/WEND
	fmt.Println("WHILE loop:")
	x = float32(1)
	for (x <= 5) {
		fmt.Print(x)
		x = float32((x + 1))
	}
	fmt.Println()
	//  DO WHILE/LOOP
	fmt.Println("DO WHILE loop:")
	x = float32(1)
	for (x <= 5) {
		fmt.Print(x)
		x = float32((x + 1))
	}
	fmt.Println()
	//  DO/LOOP UNTIL
	fmt.Println("DO UNTIL loop:")
	x = float32(1)
	for {
		fmt.Print(x)
		x = float32((x + 1))
		if (x > 5) { break }
	}
	fmt.Println()
	os.Exit(0)
}
