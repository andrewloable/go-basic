package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

var errState = rt.NewErrorState()

func main() {
	// Test error handling
	errState.SetHandler("label_handler") // ON ERROR GOTO handler
	if false { goto label_handler } // ON ERROR GOTO reachability guard
	fmt.Println("Before error")
	if _berr := errState.TriggerError(int(5), 0); _berr != nil { goto label_handler }
	//  Illegal function call
	fmt.Println("This should not print")
	os.Exit(0)
label_handler:
	fmt.Println("Error caught!")
	fmt.Println("Error code:", float64(errState.Err()))
	errState.ClearError() // RESUME NEXT — clear error and continue
}
