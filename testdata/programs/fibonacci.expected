package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Fibonacci sequence
	fib := make([]float32, int(float64(20))+1)
	fib[int(float64(0))] = float64(0)
	fib[int(float64(1))] = float64(1)
	var i float32
	end_0 := float64(20)
	step_0 := 1
	for i = float64(2); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		fib[int(i)] = (fib[int((i - float64(1)))] + fib[int((i - float64(2)))])
	}
	fmt.Println("Fibonacci sequence:")
	end_1 := float64(20)
	step_1 := 1
	for i = float64(0); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		fmt.Print(fib[int(i)])
	}
	fmt.Println()
	os.Exit(0)
}
