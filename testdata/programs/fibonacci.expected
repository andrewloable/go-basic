package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	rt.RunMain(basicMain)
}

func basicMain() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var fib []float32
	var i float32
	_ = fib
	_ = i

	// Fibonacci sequence
	fib = make([]float32, int(20)+1)
	fib[int(0)] = float32(0)
	fib[int(1)] = float32(1)
	end_0 := float32(20)
	step_0 := float32(1)
	for i = float32(2); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		fib[int(i)] = float32((fib[int((i - 1))] + fib[int((i - 2))]))
	}
	fmt.Println("Fibonacci sequence:")
	end_1 := float32(20)
	step_1 := float32(1)
	for i = float32(0); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		fmt.Print(fib[int(i)])
	}
	fmt.Println()
	os.Exit(0)
}
