package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var x float32
	var y float32
	var name_str string
	_ = x
	_ = y
	_ = name_str

	x = float32(10)
	y = float32(20)
	name_str = "Turbo BASIC"
	fmt.Println("x =", x)
	fmt.Println("y =", y)
	fmt.Println("sum =", (x + y))
	fmt.Println("name = ", name_str)
	os.Exit(0)
}
