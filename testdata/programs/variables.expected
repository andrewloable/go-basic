package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	var x float32 = float32(10)
	var y float32 = float32(20)
	var name_str string = "Turbo BASIC"
	fmt.Println("x =", x)
	fmt.Println("y =", y)
	fmt.Println("sum =", (x + y))
	fmt.Println("name = ", name_str)
	os.Exit(0)
}
