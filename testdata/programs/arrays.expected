package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Test arrays
	a := make([]float32, int(10)+1)
	matrix := make([][]float32, int(3)+1)
	for i_ := range matrix { matrix[i_] = make([]float32, int(3)+1) }
	//  Fill 1D array
	var i float32
	end_0 := float32(10)
	step_0 := float32(1)
	for i = float32(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		a[int(i)] = float32((i * i))
	}
	//  Print 1D array
	fmt.Println("Squares:")
	end_1 := float32(10)
	step_1 := float32(1)
	for i = float32(1); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		fmt.Print(a[int(i)])
	}
	fmt.Println()
	//  Fill 2D array (multiplication table)
	end_2 := float32(3)
	step_2 := float32(1)
	for i = float32(1); (step_2 > 0 && i <= end_2) || (step_2 < 0 && i >= end_2) || (step_2 == 0); i += step_2 {
		var j float32
		end_3 := float32(3)
		step_3 := float32(1)
		for j = float32(1); (step_3 > 0 && j <= end_3) || (step_3 < 0 && j >= end_3) || (step_3 == 0); j += step_3 {
			matrix[int(i)][int(j)] = float32((i * j))
		}
	}
	//  Print 2D array
	fmt.Println("Multiplication table:")
	end_4 := float32(3)
	step_4 := float32(1)
	for i = float32(1); (step_4 > 0 && i <= end_4) || (step_4 < 0 && i >= end_4) || (step_4 == 0); i += step_4 {
		end_5 := float32(3)
		step_5 := float32(1)
		for j = float32(1); (step_5 > 0 && j <= end_5) || (step_5 < 0 && j >= end_5) || (step_5 == 0); j += step_5 {
			fmt.Print(matrix[int(i)][int(j)])
		}
		fmt.Println()
	}
	os.Exit(0)
}
