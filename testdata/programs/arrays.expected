package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Test arrays
	a := make([]float32, int(float64(10))+1)
	matrix := make([]float32, int(float64(3))+1) // TODO: multi-dim
	//  Fill 1D array
	var i float32
	end_0 := float64(10)
	step_0 := 1
	for i = float64(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		a[int(i)] = (i * i)
	}
	//  Print 1D array
	fmt.Println("Squares:")
	end_1 := float64(10)
	step_1 := 1
	for i = float64(1); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		fmt.Print(a[int(i)])
	}
	fmt.Println()
	//  Fill 2D array (multiplication table)
	end_2 := float64(3)
	step_2 := 1
	for i = float64(1); (step_2 > 0 && i <= end_2) || (step_2 < 0 && i >= end_2) || (step_2 == 0); i += step_2 {
		var j float32
		end_3 := float64(3)
		step_3 := 1
		for j = float64(1); (step_3 > 0 && j <= end_3) || (step_3 < 0 && j >= end_3) || (step_3 == 0); j += step_3 {
			// TODO: multi-dim array assignment matrix[i][j] = (i * j)
		}
	}
	//  Print 2D array
	fmt.Println("Multiplication table:")
	end_4 := float64(3)
	step_4 := 1
	for i = float64(1); (step_4 > 0 && i <= end_4) || (step_4 < 0 && i >= end_4) || (step_4 == 0); i += step_4 {
		end_5 := float64(3)
		step_5 := 1
		for j = float64(1); (step_5 > 0 && j <= end_5) || (step_5 < 0 && j >= end_5) || (step_5 == 0); j += step_5 {
			fmt.Print(matrix[int(i)] /* TODO: multi-dim [i,j] */)
		}
		fmt.Println()
	}
	os.Exit(0)
}
