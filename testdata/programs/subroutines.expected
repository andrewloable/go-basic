package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Test SUB and FUNCTION
	PrintLine("Testing subroutines")
	var i float32
	end_0 := float32(10)
	step_0 := float32(1)
	for i = float32(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		fmt.Println(i, "! =", Factorial(i))
	}
	PrintLine("Done!")
	os.Exit(0)
}

func PrintLine(msg_str string) {
	fmt.Println("--- ", msg_str, " ---")
}

func Factorial(n float32) float32 {
	var Factorial float32
	if (n <= 1) {
		var Factorial float32 = float32(1)
	} else {
		Factorial = float32((n * Factorial((n - 1))))
	}
	return Factorial
}

