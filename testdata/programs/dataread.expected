package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	rt.RunMain(basicMain)
}

func basicMain() {
	var dataPool []interface{}
	_ = dataPool
	dataPool = []interface{}{
		10,
		20,
		30,
		40,
		50,
	}
	dataIdx := 0
	_ = dataIdx
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var i float32
	var x float32
	_ = i
	_ = x

	// Test DATA/READ/RESTORE
	// DATA (values collected into dataPool)
	fmt.Println("Reading data:")
	end_0 := float32(5)
	step_0 := float32(1)
	for i = float32(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		{ v_ := dataPool[dataIdx]; dataIdx++; switch tv_ := v_.(type) { case float64: x = float32(tv_); case int: x = float32(float64(tv_)); case string: x = float32(rt.Val(tv_)); default: _ = tv_ } }
		fmt.Print(x)
	}
	fmt.Println()
	dataIdx = 0 // RESTORE
	fmt.Println("After RESTORE:")
	end_1 := float32(3)
	step_1 := float32(1)
	for i = float32(1); (step_1 > 0 && i <= end_1) || (step_1 < 0 && i >= end_1) || (step_1 == 0); i += step_1 {
		{ v_ := dataPool[dataIdx]; dataIdx++; switch tv_ := v_.(type) { case float64: x = float32(tv_); case int: x = float32(float64(tv_)); case string: x = float32(rt.Val(tv_)); default: _ = tv_ } }
		fmt.Print(x)
	}
	fmt.Println()
	os.Exit(0)
}
