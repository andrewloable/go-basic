package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	rt.RunMain(basicMain)
}

func basicMain() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var I float32
	_ = I

	// Classic BASIC with line numbers
	fmt.Println("Line numbered program")
	end_0 := float32(5)
	step_0 := float32(1)
	for I = float32(1); (step_0 > 0 && I <= end_0) || (step_0 < 0 && I >= end_0) || (step_0 == 0); I += step_0 {
		fmt.Println("Count:", I)
	}
	fmt.Println("Done")
	os.Exit(0)
}
