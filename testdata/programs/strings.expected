package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Test string functions
	var s_str string = "Hello, World!"
	fmt.Println("Original: ", s_str)
	fmt.Println("Length:   ", rt.Len(s_str))
	fmt.Println("Upper:    ", rt.UCase(s_str))
	fmt.Println("Lower:    ", rt.LCase(s_str))
	fmt.Println("Left 5:   ", rt.Left(s_str, int(5)))
	fmt.Println("Right 6:  ", rt.Right(s_str, int(6)))
	fmt.Println("Mid 8,5:  ", rt.Mid(s_str, int(8), int(5)))
	fmt.Println("Trim:     ", rt.LTrim("  padded  "))
	fmt.Println("INSTR:    ", rt.Instr(1, s_str, "World"))
	fmt.Println("CHR$(65): ", func() string { v_, _ := rt.Chr(int(65)); return v_ }())
	fmt.Println("ASC(A):   ", func() int { v_, _ := rt.Asc("A"); return v_ }())
	fmt.Println("STR$(42): ", rt.Str(float64(42)))
	fmt.Println("VAL:      ", rt.Val("3.14"))
	fmt.Println("HEX$(255):", rt.Hex(int(255)))
	fmt.Println("SPACE$(5): [", rt.Space(int(5)), "]")
	fmt.Println("STRING$(3,42): ", rt.StringRepeat(int(3), byte(42)))
	os.Exit(0)
}
