package main

import (
	"fmt"
	"os"

	rt "github.com/loabletech/go-basic/internal/runtime"
)

// Suppress unused import warnings.
var _ = fmt.Sprintf
var _ = os.Exit
var _ = rt.Abs

func main() {
	// Hoisted variable declarations (avoids goto-over-declaration errors).
	var i float32
	_ = i

	// Test SELECT CASE
	end_0 := float32(10)
	step_0 := float32(1)
	for i = float32(1); (step_0 > 0 && i <= end_0) || (step_0 < 0 && i >= end_0) || (step_0 == 0); i += step_0 {
		sel_1 := i
		switch {
		case (sel_1 == 1):
			fmt.Println("one")
		case (sel_1 == 2) || (sel_1 == 3):
			fmt.Println("two or three")
		case (sel_1 >= 4 && sel_1 <= 6):
			fmt.Println("four to six")
		case (sel_1 > 8):
			fmt.Println("greater than eight")
		default:
			fmt.Println("seven or eight")
		}
	}
	os.Exit(0)
}
